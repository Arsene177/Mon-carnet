{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "seed": "pnpm run build && node --enable-source-maps ./dist/seed.mjs",
    "reset-users": "pnpm run build && node --enable-source-maps ./dist/reset-users.mjs",
    "backup": "pnpm run build && node --enable-source-maps ./dist/backup.mjs backup",
    "backup:verify": "pnpm run build && node --enable-source-maps ./dist/backup.mjs verify",
    "backup:restore": "pnpm run build && node --enable-source-maps ./dist/backup.mjs restore",
    "backup:download": "pnpm run build && node --enable-source-maps ./dist/backup.mjs download",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:accessibility": "pnpm run build && node --test tests/accessibility/*.test.mjs",
    "migrate-to-supabase": "pnpm run build && node --enable-source-maps ./dist/migrate-to-supabase.mjs"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "axe-core": "4.10.3",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "8.23.0",
    "pino-pretty": "^13.1.3",
    "playwright": "1.63.0",
    "thread-stream": "3.1.0"
  }
}
